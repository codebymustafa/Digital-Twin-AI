# =============================================================================
# DIGITAL TWIN AI - ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# =============================================================================
# Copy this file to '.env' inside the /backend directory and replace placeholder
# values with your actual service credentials.
#
# IMPORTANT: Never commit actual secret keys or credentials to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. SERVER CONFIGURATION
# -----------------------------------------------------------------------------
# The local port number the Express backend server listens on.
# Default: 5000
PORT=5000

# -----------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION
# -----------------------------------------------------------------------------
# MongoDB connection URI (Atlas cloud cluster or local mongod instance).
# Used by: backend/Configuration/dbConnection.js
# Obtain from: https://www.mongodb.com/cloud/atlas or mongodb://127.0.0.1:27017/digital_twin_ai
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/digital_twin_ai?retryWrites=true&w=majority

# -----------------------------------------------------------------------------
# 3. AUTHENTICATION & SECURITY
# -----------------------------------------------------------------------------
# Cryptographic secret key used to sign and verify JSON Web Tokens (JWT).
# Used by: backend/routes/auth.js, backend/routes/admin.js, backend/routes/clone.js
# Generate: Any high-entropy random string (e.g. openssl rand -base64 32)
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_random_string

# -----------------------------------------------------------------------------
# 4. ARTIFICIAL INTELLIGENCE & LLM APIS
# -----------------------------------------------------------------------------
# Groq Cloud API Key (Powers ultra-fast Llama-3 inference for Twin chat & simulation).
# Used by: backend/models/aiService.js
# Obtain from: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here

# Hugging Face API Token (Inference API fallback provider for language models).
# Used by: backend/models/aiService.js
# Obtain from: https://huggingface.co/settings/tokens
HF_API_KEY=hf_your_huggingface_access_token_here

# -----------------------------------------------------------------------------
# 5. LIVE EXTERNAL DATA FEEDS & TELEMETRY
# -----------------------------------------------------------------------------
# GNews API Key (Provides global & regional live news headlines).
# Used by: backend/services/liveDataService.js
# Obtain from: https://gnews.io/
GNEWS_API_KEY=your_gnews_api_key_here

# NewsData.io API Key (Secondary/alternative news provider).
# Used by: backend/services/liveDataService.js
# Obtain from: https://newsdata.io/
NEWSDATA_KEY=pub_your_newsdata_api_key_here

# Cricket Data API Key (Live cricket scores and sports updates).
# Used by: backend/services/liveDataService.js
# Obtain from: https://cricketdata.org/
CRICKET_API_KEY=your_cricket_data_api_key_here

# NASA Open API Key (Astronomy Picture of the Day & space telemetry).
# Used by: backend/services/liveDataService.js
# Obtain from: https://api.nasa.gov/ (or use DEMO_KEY for testing)
NASA_API_KEY=DEMO_KEY

# AQICN / World Air Quality Index Token (Real-time air quality index feed).
# Used by: backend/services/liveDataService.js
# Obtain from: https://aqicn.org/data-platform/token/
AQICN_TOKEN=your_aqicn_platform_token_here

# -----------------------------------------------------------------------------
# 6. LOCAL FUEL TELEMETRY (PKR)
# -----------------------------------------------------------------------------
# Reference prices for local petroleum and diesel in PKR per liter.
# Used by: backend/services/liveDataService.js
FUEL_PETROL_PKR=275.60
FUEL_DIESEL_PKR=283.25
FUEL_LAST_UPDATED=2026-03-01
